# Copy to .env locally. The Python service reads environment variables, not this file.
# Docker Compose loads this file when passed --env-file .env.
DEPBRIDGE_DATA_DIR=.depbridge
DEPBRIDGE_PUBLIC_BASE_URL=http://127.0.0.1:8000
DEPBRIDGE_FRONTEND_DIR=frontend
DEPBRIDGE_ALLOWED_REPOSITORIES=rishrek/LinkWatch
DEPBRIDGE_MAX_PENDING_JOBS=8
DEPBRIDGE_ENGINE_MODE=auto
# Server-side only. Never put these in frontend files or commit real values.
GEMINI_API_KEY=
GOOGLE_API_KEY=
